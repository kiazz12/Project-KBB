APP_NAME="KBB Forms"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database — default SQLite (tanpa konfigurasi tambahan).
# Untuk MySQL, ganti DB_CONNECTION=mysql dan isi kredensial di bawah.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=kbb_forms
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local

# Mail — default 'log' (aman untuk pengembangan lokal).
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@kbb.go.id"
MAIL_FROM_NAME="${APP_NAME}"

BCRYPT_ROUNDS=12

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,localhost:5173
